# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ccsi_training

# ── API Key ──────────────────────────────────────────────────────────────────
API_KEY=your-api-key-here

# ── Email — Pilih salah satu: Graph API (utama) atau SMTP (fallback) ─────────
#
# Opsi 1: Microsoft Graph API (diutamakan jika ketiga variabel ini diisi)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret

# Opsi 2: SMTP (digunakan jika Graph API tidak dikonfigurasi)
# Email approval HANYA dikirim jika SMTP_HOST diisi
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@ccsi.co.id
SMTP_PASS=your-smtp-password
SMTP_FROM="CCSI Training" <noreply@ccsi.co.id>

# ── Approval default (fallback jika tidak dipilih di form) ───────────────────
APPROVAL_EMAIL=direktur@ccsi.co.id
HRD_DIRECTOR_EMAIL=hrd@ccsi.co.id
HRD_DIRECTOR_NAME=Direktur HRD

# ── Deploy secret (opsional) ─────────────────────────────────────────────────
DEPLOY_SECRET=your-deploy-secret
