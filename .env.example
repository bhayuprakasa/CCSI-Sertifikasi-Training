# ─────────────────────────────────────────────────────────────
# CCSI Sertifikasi Training — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya sebelum menjalankan server.
# JANGAN commit file .env ke repository.
# ─────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────
PORT=3000

# URL publik aplikasi (WAJIB diset di server produksi).
# Digunakan sebagai allowlist CORS dan base-URL pada link email.
# Contoh: https://training.ccsi.co.id
APP_URL=https://your-domain.com

# Origin tambahan yang diizinkan oleh CORS (opsional, pisahkan dengan koma).
# APP_URL sudah otomatis masuk allowlist; gunakan ini untuk origin lain.
# Jika APP_URL tidak diset, CORS akan menolak semua cross-origin request.
# CORS_ORIGINS=https://app2.ccsi.co.id,https://admin.ccsi.co.id

# ── Database (MySQL) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ccsi_training

# ── API Key (header X-API-Key wajib pada semua /api/*) ───────
API_KEY=ganti-dengan-kunci-rahasia-panjang

# ── Email — pilih salah satu: Microsoft Graph atau SMTP ──────

# Opsi A: Microsoft Graph API (Office 365)
# GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# GRAPH_CLIENT_SECRET=your-graph-client-secret

# Opsi B: SMTP biasa
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@ccsi.co.id
# SMTP_PASS=your-smtp-password
# SMTP_FROM="CCSI Training" <noreply@ccsi.co.id>

# ── Approval workflow ────────────────────────────────────────
# Email default approver jika tidak dikonfigurasi per-karyawan.
# APPROVAL_EMAIL=hrd@ccsi.co.id

# Email & nama Direktur HRD untuk notifikasi approval tahap HRD.
# HRD_DIRECTOR_EMAIL=direktur.hrd@ccsi.co.id
# HRD_DIRECTOR_NAME=Direktur HRD
